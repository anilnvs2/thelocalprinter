# Server
PORT=5000
NODE_ENV=development

# Frontend URLs allowed for CORS / sockets (comma-separated)
CLIENT_URL=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/localprinter

# Auth
JWT_SECRET=replace_with_long_random_string
JWT_EXPIRES_IN=7d

# No admin credentials here — admin is created by the script (src/scripts/seedAdmin.js):
#   npm run seed:admin  or  npm run seed:admin -- --password "..."

# OTP email — Brevo transactional API (in use)
BREVO_API_KEY=your_brevo_api_key
OTP_FROM_EMAIL=no-reply@yourdomain.com
OTP_FROM_NAME=Local Printer

# Image uploads — Cloudinary (in use)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Legacy / currently unused by any controller
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# RESEND_API_KEY=

